body {
    font-family: Arial, sans-serif;
    text-align: center;
    background: #f5f5f5;
}

header {
    background: #1f4e79;
    color: white;
    padding: 40px;
}

section {
    margin-top: 40px;
}

button {
    padding: 15px 25px;
    margin: 10px;
    cursor: pointer;
}

body{

    background:#f4f6f9;

    font-family:'Poppins',sans-serif;

}

.navbar{

    box-shadow:0 3px 15px rgba(0,0,0,.15);

}

.navbar-brand{

    font-size:24px;

}

.hero{

    padding:90px 20px;

    text-align:center;

}

.hero h1{

    font-size:60px;

    font-weight:700;

}

.hero p{

    font-size:20px;

    color:#666;

}

.card{

    border:none;

    border-radius:18px;

    transition:.3s;

    box-shadow:0 10px 30px rgba(0,0,0,.08);

}

.card:hover{

    transform:translateY(-8px);

}

.footer{

    background:#111;

    color:white;

    padding:50px;

    margin-top:80px;

}

.btn{

    border-radius:12px;

}

.stat{

    font-size:45px;

    font-weight:bold;

    color:#0d6efd;

}.form-control{
    border-radius:10px;
    padding:12px;
}

.card{
    border-radius:20px;
}

.btn{
    padding:12px;
    font-weight:600;
}

label{
    font-weight:500;
}

body{
    min-height:100vh;
}.card img{

    height:250px;

    object-fit:cover;

}

.card{

    overflow:hidden;

}

.badge{

    font-size:14px;

}

.card-title{

    font-weight:bold;

}